{
  "name": "trading-vibes-market-data",
  "main": "market-data-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {"name": "MARKET_HUB", "class_name": "MarketDataHub"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["MarketDataHub"]}
  ],
  "observability": {"enabled": true}
}

