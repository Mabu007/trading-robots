{
  "name": "trading-vibes-propdao-live",
  "main": "propdao-live-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "BOTS",
        "class_name": "PropDAOLiveBot"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PropDAOLiveBot"
      ]
    }
  ],
  "vars": {
    "PROPDAO_CONTROL_URL": "https://trading-robots.vercel.app"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "PROPDAO_LIVE_INTERNAL_SECRET"
    ]
  }
}
