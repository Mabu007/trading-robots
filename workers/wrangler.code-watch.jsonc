{
  "name": "trading-vibes-code-watch",
  "main": "code-watch-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCHES",
        "class_name": "CodeWatch"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CodeWatch"
      ]
    }
  ],
  "vars": {
    "CODE_WATCH_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}