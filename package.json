{
  "name": "tradefoundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run --config vitest.config.ts",
    "server": "node --import tsx server/local.ts",
    "dev:all": "npm run dev",
    "check:runtime": "tsc -p workers/tsconfig.json",
    "test:valr-paper": "node scripts/test-valr-paper.mjs",
    "worker:valr:build": "wrangler deploy --dry-run --config workers/wrangler.valr-preview.jsonc",
    "test:valr-live": "node scripts/test-valr-live.mjs",
    "test:valr-live-runtime": "node scripts/test-valr-live-runtime.mjs",
    "worker:valr:live:build": "wrangler deploy --dry-run --config workers/wrangler.valr-live.jsonc",
    "worker:propdao:live:build": "wrangler deploy --dry-run --config workers/wrangler.propdao-live.jsonc"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.85",
    "@ai-sdk/react": "^4.0.167",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@cf-wasm/quickjs": "0.3.0",
    "@composio/core": "^0.28.0",
    "@composio/vercel": "^0.13.0",
    "@json-render/core": "^0.22.0",
    "@json-render/react": "^0.22.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "ai": "^7.0.163",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
