{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server/**,shared/**,src/strategy.ts,src/types.ts}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:apiPath*",
      "destination": "/api/index?apiPath=:apiPath*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
