{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server/**,shared/**,src/strategy.ts,src/types.ts,src/engine.ts,src/tool-trace.ts,src/entry-fill-guard.ts,src/strategy-runtime.ts,workers/strategy-sandbox.ts}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:apiPath*",
      "destination": "/api/index?apiPath=:apiPath*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/phase2-complete": false,
      "codex/propdao-research-connections": false,
      "codex/composio-catalogue-production": false,
      "codex/phase2-unified-runtime-20261107": false,
      "codex/phase2-strategy-validation-20261107": false,
      "codex/phase2-auth-rollout-validation-20261106": false
    }
  }
}
