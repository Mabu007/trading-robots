# Optional administrator fallback; disabled unless explicitly enabled.
ALLOW_SHARED_OPENROUTER_KEY=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# Independent 32-byte base64 keys for personal AI and VALR credentials.
AI_CREDENTIAL_ENCRYPTION_KEY=
VALR_CREDENTIAL_ENCRYPTION_KEY=
# Private paper runtime endpoint and shared backend secret.
VALR_PAPER_RUNTIME_URL=
VALR_PAPER_INTERNAL_SECRET=
APP_URL=http://localhost:5173
API_PORT=8787
FIREBASE_PROJECT_ID=

# Firebase Web app config (these values are public client config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Private Cloudflare R2 (server-side only; keep these out of VITE_ variables)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trading-vibes-marketdata
# Optional public custom domain, informational only. The app uses private signed reads.
R2_PUBLIC_BASE_URL=

# Server-only Firebase service account with narrowly scoped Firestore access.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
