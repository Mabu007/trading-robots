OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_FALLBACK_MODEL=cohere/north-mini-code:free
APP_URL=http://localhost:5173
API_PORT=8787
FIREBASE_PROJECT_ID=
# Comma-separated Firebase UIDs allowed to overwrite shared market history.
MARKET_DATA_IMPORT_UIDS=

# Firebase Web app config (these values are public client config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Private Cloudflare R2 (server-side only; keep these out of VITE_ variables)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trading-vibes-marketdata
# Optional public custom domain, informational only. The app uses private signed reads.
R2_PUBLIC_BASE_URL=

# cTrader Open API app credentials (server only). Register the exact callback URL.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://trading-robots.vercel.app/api/brokers/ctrader/callback
# CTRADER_SECRET_KEY is accepted as an alias for CTRADER_CLIENT_SECRET.
# The redirect URI must also be registered in the approved cTrader application.

# Server-only Firebase service account with narrowly scoped Firestore access.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Independent AES-256 key, base64 encoded. Configure the same key on API/gateway.
BROKER_TOKEN_ENCRYPTION_KEY=
# Keep the previous key temporarily during credential rewrapping.
BROKER_TOKEN_PREVIOUS_KEY=

# Shared backend authentication, >=32 random characters; never expose via VITE_.
TRADING_INTERNAL_SECRET=
ROBOT_RUNTIME_URL=
CTRADER_GATEWAY_URL=
CONTROL_API_URL=

# Persistent Node gateway. Run exactly one replica for shared demo/live sockets.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
# Remains false until actual broker demo verification is completed.
DEMO_TRADING_ENABLED=false
# Worker-only gate: requires production CPU/network isolation verification.
STRATEGY_ISOLATION_VERIFIED=false

# Infrastructure configuration script; reuse the existing application R2 bucket.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ROBOT_WORKER_NAME=
SIGNAL_QUEUE_NAME=
SIGNAL_DEAD_QUEUE_NAME=
